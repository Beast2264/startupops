# Copy this file to .env and edit if you want to change defaults.
# This app does NOT load .env automatically (no python-dotenv dependency) —
# these are just the environment variables it reads, documented here for
# reference. Set them in PowerShell with $env:NAME = "value" before running,
# or wire up your own .env loader if you prefer.

# ---- Data backend ----------------------------------------------------------
# "memory" (default): seeded in-memory repository. No account, no network,
# nothing persisted between restarts. This is what you get with no setup.
STARTUPOPS_DATA_BACKEND=memory

# "firestore" (or "live"): persist to YOUR OWN Google Cloud Firestore
# database. Requires the two variables below, plus Application Default
# Credentials for that project (gcloud auth application-default login) and
# the Firestore API enabled on it. There is no default/bundled project.
# STARTUPOPS_DATA_BACKEND=firestore
# STARTUPOPS_FIRESTORE_PROJECT=your-own-gcp-project-id
# STARTUPOPS_FIRESTORE_DATABASE=(default)

# ---- Safety switch ----------------------------------------------------------
# When true, ALL writes are refused regardless of backend (reads still work).
# Useful if you want a read-only preview mode.
# STARTUPOPS_READ_ONLY=false

# ---- Firestore emulator (local testing only, no cloud account needed) ------
# Set this instead of the above to point FirestoreRepository at a local
# emulator instead of a real project. See tests/test_firestore_emulator.py.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
